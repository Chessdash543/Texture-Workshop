{
	"geode": "5.6.1",
	"gd": {
		"win": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081",
		"android": "2.2081"
	},
	"version": "v1.0.4",
	"id": "chessdash543.tms",
	"name": "Texture Makers Workshop",
	"developer": "TMS Team",
	"description": "A fork from Texture WorkShop :)",
	"dependencies": {
		"geode.texture-loader": ">=1.10.2"
	},
	"resources": {
		"spritesheets": {
			"TMSSheet": [
				"resources/TMSSheet/*.png"
			]
		},
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"cert-verification": {
			"name": "Cert Verification",
			"description": "Enable Cert Verification",
			"type": "bool",
			"default": true
		},

		"version-filter": {
			"name": "Version Filter",
			"description": "Filter TPs to only show TPs that support the current GD Version",
			"type": "bool",
			"default": true
		}
	},
	"tags": [
		"universal", "utility", "interface", "enhancement", "customization", "fork"
	]
}
